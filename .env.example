# Optional JSON sensor endpoint. It should accept ?location_id= and return rainfall, soil_moisture, slope_angle.
VITE_SENSOR_API_URL=

# Frontend API base URL. Local development uses the Express API on port 5000.
VITE_API_URL=http://localhost:5000

# Backend settings. DEMO values are used when these integrations are empty.
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
VITE_WEATHER_URL=https://api.open-meteo.com/v1/forecast
SENSOR_API_URL=
